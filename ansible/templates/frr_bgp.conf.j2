! FRR config for the router: eBGP with the control-plane nodes, rendered by
! make config from ansible/inventory.yaml. Cluster side: payload/platform/cilium/bgp.yaml.
! Comments are only valid on their own line; FRR rejects trailing comments.
!
frr defaults traditional
!
router bgp {{ router_asn }}
 bgp router-id {{ router_ip }}
 bgp ebgp-requires-policy
 !
 neighbor cilium peer-group
 neighbor cilium remote-as {{ cluster_asn }}
{% for ip in groups['control_plane'] | map('extract', hostvars, 'ansible_host') | sort %}
 neighbor {{ ip }} peer-group cilium
{% endfor %}
 !
 address-family ipv4 unicast
  maximum-paths {{ groups['control_plane'] | length }}
  neighbor cilium activate
  neighbor cilium soft-reconfiguration inbound
  neighbor cilium route-map ALLOW-ALL in
  neighbor cilium route-map ALLOW-ALL out
  neighbor cilium next-hop-self
 exit-address-family
exit
!
route-map ALLOW-ALL permit 10
exit
!
