variant: flatcar
version: 1.0.0
passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - "{{ lookup('file', '~/.ssh/id_ed25519.pub') }}"
storage:
  disks:
    - device: {{ install_disk }}
      # Flatcar is installed to this disk, so partitions 1-9 belong to the OS
      # and are not ours to define. `wipe_table` must stay false: setting it
      # would erase the install this config is running from.
      #
      # ROOT is partition 9 and normally grows to fill whatever is left of the
      # disk, which would leave nothing for anything below. Capping it here is
      # what makes room.
      #
      # The filesystem does *not* follow the partition on its own. Taking
      # partition 9 over here is exactly what stops Flatcar's first-boot growth
      # from happening, so ROOT ends up a 25GB partition holding the image's
      # original ~1.6GB filesystem. grow-root.service below is what closes that
      # gap; the two have to be changed together.
      #
      # Partition order is load-bearing. rook-osd is raw and unformatted, so its
      # contents are whatever Ceph last wrote there -- inserting a partition
      # ahead of it moves its start offset and takes the OSD data with it.
      # Changing anything above rook-osd means reinstalling, one node at a time.
      # See docs/operations/index.md#repartitioning-the-nodes.
      wipe_table: false
      partitions:
        # /, and with it /etc, /var/lib/etcd, /var/lib/rook and the sysext
        # images under /opt/extensions. All of which now survive a reboot.
        - label: ROOT
          number: 9
          size_mib: 25600  # 25GB, capped so the partitions below fit
          resize: true
        - label: containerd
          number: 10
          size_mib: 51200  # 50GB for container images
        # Backs the kubelet root directory, which is what the kubelet reports as
        # node ephemeral-storage. This is why image CVE scanning can schedule:
        # on the tmpfs root it was ~3.6GB of RAM on the control-plane nodes.
        - label: kubelet
          number: 11
          size_mib: 40960  # 40GB for pod ephemeral storage and volumes
        # Container logs, the journal and the API server audit log.
        - label: varlog
          number: 12
          size_mib: 10240  # 10GB for /var/log
        - label: rook-osd
          number: 13
          size_mib: 0      # Use remaining space for Rook OSD
  filesystems:
    # `wipe_filesystem` applies the one time Ignition runs, on the first boot
    # after the install. It is not a recurring wipe: on an installed node
    # Ignition does not run again, so everything below survives every
    # subsequent reboot.
    - path: /var/lib/containerd
      device: /dev/disk/by-partlabel/containerd
      format: xfs
      wipe_filesystem: true
      with_mount_unit: true
    # `/` is mounted shared and a mount created beneath it inherits that, which
    # is what the Ceph CSI driver needs in order to propagate volume mounts back
    # out of /var/lib/kubelet/pods. Nothing extra is required to arrange it; it
    # is recorded here because the failure mode if it were ever not true is pods
    # hanging on mount errors that mention nothing about propagation.
    - path: /var/lib/kubelet
      device: /dev/disk/by-partlabel/kubelet
      format: xfs
      wipe_filesystem: true
      with_mount_unit: true
    # systemd-journal-flush.service is ordered after local-fs.target precisely so
    # that /var/log can be its own mount: journald writes to /run/log/journal
    # until the flush and only then moves to the mounted filesystem. Mounting
    # here does not strand the journal behind the mountpoint.
    - path: /var/log
      device: /dev/disk/by-partlabel/varlog
      format: xfs
      wipe_filesystem: true
      with_mount_unit: true
    # rook-osd is left unformatted -- Ceph wants the raw block device and
    # declines anything carrying a filesystem. `format: none` with
    # `wipe_filesystem` is how Ignition expresses exactly that: erase what is
    # there, put nothing back, do not mount it.
    #
    # Which matters because the partition is new but the bytes under it are not.
    # A rebuilt node inherits whatever the previous cluster's OSD wrote at that
    # offset, and `ceph-volume` reads the BlueStore signature rather than the
    # partition table, so Rook finds an OSD belonging to a cluster that no
    # longer exists and refuses to adopt it -- leaving the node with no storage
    # and the CephCluster reporting Ready. See
    # docs/platform/rook-ceph.md#no-osds-after-reprovisioning.
    - device: /dev/disk/by-partlabel/rook-osd
      format: none
      wipe_filesystem: true
  directories:
    - path: /etc/kubernetes/manifests
      mode: 0755
{% if role == 'control-plane' %}
    - path: /etc/kubernetes/enc
      mode: 0700
    - path: /etc/kubernetes/audit
      mode: 0700
    # The API server writes its audit log here, on the varlog partition, where
    # it now survives a reboot. Alloy still tails it into Loki -- that is what
    # makes it queryable next to everything else and what keeps a copy when the
    # node itself is the thing that failed. See docs/architecture/security.md.
    - path: /var/log/kubernetes/audit
      mode: 0700
{% endif %}
  files:
    - path: /etc/containerd/config.toml
      mode: 0644
      contents:
        # Config version 3 with the io.containerd.cri.v1.runtime plugin path is
        # the containerd 2.x form. Version 2 is still auto-converted, but the
        # conversion is the deprecated path and goes away in containerd 3.
        inline: |
          version = 3
          [plugins.'io.containerd.cri.v1.runtime'.containerd.runtimes.runc]
            runtime_type = "io.containerd.runc.v2"
          [plugins.'io.containerd.cri.v1.runtime'.containerd.runtimes.runc.options]
            SystemdCgroup = true
    - path: /etc/hostname
      mode: 0644
      contents:
        inline: "{{ inventory_hostname }}"

    - path: /opt/kubeadm-config.yaml
      mode: 0644
      contents:
        inline: |
          {{ lookup('template', '../templates/kubeadm.yaml.j2') | indent(10) }}
{% if role == 'control-plane' %}
    # Key material for API server Secret encryption at rest. Generated once by
    # `make config` into output/credentials/encryption_key and reused on every
    # run, so all control-plane nodes share one key -- they must, or a Secret
    # written through one API server is unreadable through another.
    - path: /etc/kubernetes/enc/encryption-config.yaml
      mode: 0600
      contents:
        inline: |
          apiVersion: apiserver.config.k8s.io/v1
          kind: EncryptionConfiguration
          resources:
            - resources:
                - secrets
              providers:
                - secretbox:
                    keys:
                      - name: key1
                        secret: {{ encryption_key }}
                - identity: {}

    # What the API server records, and at which level. Without a policy file the
    # audit log is not merely empty -- the API server does not open one at all,
    # and `--audit-log-path` on its own achieves nothing.
    #
    # Rules are evaluated top to bottom and the first match wins, so the order
    # below is the whole design. `omitStages: RequestReceived` drops the
    # half of every event that says only "someone asked"; the matching response
    # stage carries the same information plus the outcome.
    - path: /etc/kubernetes/audit/policy.yaml
      mode: 0600
      contents:
        inline: |
          apiVersion: audit.k8s.io/v1
          kind: Policy
          omitStages:
            - RequestReceived
          rules:
            # Endpoints polled continuously by kubelets, probes and Prometheus.
            # None of them carry a decision worth reviewing, and together they
            # are the majority of requests this cluster serves.
            - level: None
              nonResourceURLs:
                - /healthz*
                - /livez*
                - /readyz*
                - /version
                - /metrics
                - /openapi*

            # Leases are renewed every few seconds by every control-plane
            # component and every kubelet; Events are written by everything.
            # Both would bury the log in traffic that says nothing happened.
            - level: None
              resources:
                - group: "coordination.k8s.io"
                  resources: ["leases"]
                - group: ""
                  resources: ["events"]

            # The control plane and the kubelets read their way through the API
            # constantly. Their reads are not the ones anyone goes looking for,
            # and dropping them here is what keeps the Secret rule below
            # affordable.
            - level: None
              users:
                - system:apiserver
                - system:kube-scheduler
                - system:kube-controller-manager
              verbs: ["get", "list", "watch"]
            - level: None
              userGroups: ["system:nodes"]
              verbs: ["get", "list", "watch"]

            # Secret access by anything else, reads included -- a read is the
            # interesting verb here, and it is the one a plain write-only audit
            # policy misses. Metadata and never higher: at Request or
            # RequestResponse the audit log becomes a second, unencrypted copy
            # of every Secret in the cluster, sitting in a flat file next to the
            # etcd that was carefully encrypted to prevent exactly that.
            - level: Metadata
              resources:
                - group: ""
                  resources: ["secrets", "configmaps"]
                - group: "authentication.k8s.io"
                  resources: ["tokenreviews"]

            # Interactive access to a running container. RequestResponse is the
            # difference between knowing that someone exec'd into a pod and
            # knowing which pod, as which user, running what.
            - level: RequestResponse
              resources:
                - group: ""
                  resources: ["pods/exec", "pods/attach", "pods/portforward"]

            # Everything else that only reads.
            - level: None
              verbs: ["get", "list", "watch"]

            # Everything that changes state. Metadata is also the level that
            # carries the Pod Security Admission annotations, which is what
            # makes the `audit` half of the PSA labels in
            # payload/platform/security/pod-security.yaml mean anything.
            - level: Metadata

    # kube-vip holds the API server VIP on whichever control-plane node wins the
    # leader election, so controlPlaneEndpoint does not depend on one machine.
    # Placed here rather than applied later: it has to be running before kubeadm
    # writes the endpoint into the cluster certificates.
    - path: /etc/kubernetes/manifests/kube-vip.yaml
      mode: 0644
      contents:
        inline: |
          apiVersion: v1
          kind: Pod
          metadata:
            name: kube-vip
            namespace: kube-system
          spec:
            containers:
              - name: kube-vip
                image: ghcr.io/kube-vip/kube-vip:{{ kube_vip_version }}
                imagePullPolicy: IfNotPresent
                args:
                  - manager
                env:
                  - name: address
                    value: "{{ control_plane_vip }}"
                  - name: port
                    value: "6443"
                  - name: vip_interface
                    value: "{{ control_plane_vip_interface }}"
                  - name: vip_subnet
                    value: "32"
                  - name: vip_arp
                    value: "true"
                  - name: cp_enable
                    value: "true"
                  - name: cp_namespace
                    value: kube-system
                  - name: vip_leaderelection
                    value: "true"
                  - name: vip_leaseduration
                    value: "5"
                  - name: vip_renewdeadline
                    value: "3"
                  - name: vip_retryperiod
                    value: "1"
                  # Cilium owns LoadBalancer services via L2 announcements.
                  # kube-vip must not also claim them.
                  - name: svc_enable
                    value: "false"
                securityContext:
                  capabilities:
                    add:
                      - NET_ADMIN
                      - NET_RAW
                      - SYS_TIME
                volumeMounts:
                  - mountPath: /etc/kubernetes/admin.conf
                    name: kubeconfig
            hostAliases:
              - hostnames:
                  - kubernetes
                ip: 127.0.0.1
            hostNetwork: true
            volumes:
              - name: kubeconfig
                hostPath:
                  path: /etc/kubernetes/admin.conf
{% endif %}
    - path: /etc/modules-load.d/k8s.conf
      mode: 0644
      contents:
        inline: |
          overlay
          br_netfilter
    - path: /etc/sysctl.d/k8s.conf
      mode: 0644
      contents:
        inline: |
          net.bridge.bridge-nf-call-iptables = 1
          net.bridge.bridge-nf-call-ip6tables = 1
          net.ipv4.ip_forward = 1


    - path: /etc/sysupdate.d/kubernetes.conf
      contents:
        source: http://{{ boot_server_ip }}:8000/kubernetes.conf
    - path: /opt/extensions/kubernetes/kubernetes-{{ kubernetes_version }}-x86-64.raw
      contents:
        source: http://{{ boot_server_ip }}:8000/kubernetes-{{ kubernetes_version }}-x86-64.raw
    - path: /etc/sysupdate.d/containerd.conf
      contents:
        source: http://{{ boot_server_ip }}:8000/containerd.conf
    - path: /opt/extensions/containerd/containerd-{{ containerd_version }}-x86-64.raw
      contents:
        source: http://{{ boot_server_ip }}:8000/containerd-{{ containerd_version }}-x86-64.raw
    - path: /etc/sysupdate.d/noop.conf
      contents:
        source: http://{{ boot_server_ip }}:8000/noop.conf
  links:
    - path: /etc/extensions/docker-flatcar.raw
      target: /dev/null
      overwrite: true
    - path: /etc/extensions/containerd-flatcar.raw
      target: /dev/null
      overwrite: true
    - path: /etc/extensions/containerd.raw
      target: /opt/extensions/containerd/containerd-{{ containerd_version }}-x86-64.raw
      overwrite: true
    - path: /etc/extensions/kubernetes.raw
      target: /opt/extensions/kubernetes/kubernetes-{{ kubernetes_version }}-x86-64.raw
      overwrite: true

systemd:
  units:
    # Capping ROOT in the disks stanza above is also what stops it growing.
    # Flatcar's stock growth is systemd-growfs-root.service, which is `static`
    # -- it is pulled in by an `x-systemd.growfs` mount option, and the root
    # here is mounted from `root=LABEL=ROOT` on the kernel command line, which
    # carries no such option. Ignition resizes the partition and nothing
    # resizes the filesystem, so a node comes up with a 25GB ROOT partition
    # holding the image's original ~1.6GB filesystem.
    #
    # That leaves about 1.2GB free on the filesystem /var/lib/etcd and
    # /var/lib/rook both live on, which is not a cosmetic problem.
    - name: grow-root.service
      enabled: true
      contents: |
        [Unit]
        Description=Grow the root filesystem into its partition
        After=local-fs.target
        Before=kubelet.service bootstrap-k8s.service

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        # The same binary the stock unit runs, and a no-op once the filesystem
        # already fills the partition -- so this is safe on every later boot.
        ExecStart=/usr/lib/systemd/systemd-growfs /
        TimeoutSec=infinity

        [Install]
        WantedBy=multi-user.target
    - name: kubelet.service
      enabled: true
      dropins:
        - name: 20-kubelet.conf
          contents: |
            [Service]
            ExecStart=
            ExecStart=/usr/bin/kubelet $KUBELET_KUBECONFIG_ARGS $KUBELET_CONFIG_ARGS $KUBELET_KUBEADM_ARGS $KUBELET_EXTRA_ARGS
    - name: systemd-sysupdate.timer
      enabled: true
    - name: systemd-sysupdate.service
      dropins:
        - name: containerd.conf
          contents: |
            [Service]
            ExecStartPre=/usr/bin/sh -c "readlink --canonicalize /etc/extensions/containerd.raw > /tmp/containerd"
            ExecStartPre=/usr/lib/systemd/systemd-sysupdate -C containerd update
            ExecStartPost=/usr/bin/sh -c "readlink --canonicalize /etc/extensions/containerd.raw > /tmp/containerd-new"
            ExecStartPost=/usr/bin/sh -c "if ! cmp --silent /tmp/containerd /tmp/containerd-new; then touch /run/reboot-required; fi"

        - name: kubernetes.conf
          contents: |
            [Service]
            ExecStartPre=/usr/bin/sh -c "readlink --canonicalize /etc/extensions/kubernetes.raw > /tmp/kubernetes"
            ExecStartPre=/usr/lib/systemd/systemd-sysupdate -C kubernetes update
            ExecStartPost=/usr/bin/sh -c "readlink --canonicalize /etc/extensions/kubernetes.raw > /tmp/kubernetes-new"
            ExecStartPost=/usr/bin/sh -c "if ! cmp --silent /tmp/kubernetes /tmp/kubernetes-new; then touch /run/reboot-required; fi"
    - name: containerd.service
      dropins:
        - name: 10-config.conf
          contents: |
            [Service]
            Environment=CONTAINERD_CONFIG=/etc/containerd/config.toml
    - name: locksmithd.service
      mask: true
    # locksmithd is masked because Kured coordinates reboots instead, draining
    # the node first. update-engine stages an OS update but does not write a
    # sentinel anywhere, so translate its status into the same
    # /run/reboot-required marker the sysupdate drop-ins above already use.
    # /run is tmpfs, so the marker clears itself on reboot.
    - name: flatcar-reboot-sentinel.service
      contents: |
        [Unit]
        Description=Flag a staged Flatcar OS update for Kured
        ConditionPathExists=/usr/bin/update_engine_client

        [Service]
        Type=oneshot
        ExecStart=/usr/bin/sh -c '/usr/bin/update_engine_client -status | grep -q UPDATE_STATUS_UPDATED_NEED_REBOOT && touch /run/reboot-required || true'
    - name: flatcar-reboot-sentinel.timer
      enabled: true
      contents: |
        [Unit]
        Description=Check every 10 minutes whether a Flatcar OS update is staged

        [Timer]
        OnBootSec=5min
        OnUnitActiveSec=10min

        [Install]
        WantedBy=timers.target
    - name: bootstrap-k8s.service
      enabled: true
      contents: |
        [Unit]
        Description=Bootstrap Kubernetes Cluster
        After=network-online.target
        Wants=network-online.target
        ConditionPathExists=!/etc/kubernetes/kubelet.conf

        [Service]
        Type=oneshot
        {% if role == 'control-plane' %}
        {% if inventory_hostname == groups['control_plane'][0] %}
        # Since Kubernetes 1.29 admin.conf is not usable until init completes, so
        # kube-vip is pointed at super-admin.conf for the duration and moved back
        # afterwards. Only the hostPath changes; the in-container path stays
        # /etc/kubernetes/admin.conf.
        ExecStartPre=/usr/bin/sed -i 's#path: /etc/kubernetes/admin.conf#path: /etc/kubernetes/super-admin.conf#' /etc/kubernetes/manifests/kube-vip.yaml
        ExecStart=/usr/bin/kubeadm init --config /opt/kubeadm-config.yaml --upload-certs --ignore-preflight-errors=DirAvailable--etc-kubernetes-manifests
        ExecStartPost=/usr/bin/sed -i 's#path: /etc/kubernetes/super-admin.conf#path: /etc/kubernetes/admin.conf#' /etc/kubernetes/manifests/kube-vip.yaml
        {% else %}
        ExecStart=/usr/bin/kubeadm join {{ control_plane_endpoint }} --token {{ kubeadm_token }} --discovery-token-unsafe-skip-ca-verification --control-plane --certificate-key {{ certificate_key }} --ignore-preflight-errors=DirAvailable--etc-kubernetes-manifests
        {% endif %}
        {% else %}
        ExecStart=/usr/bin/kubeadm join {{ control_plane_endpoint }} --token {{ kubeadm_token }} --discovery-token-unsafe-skip-ca-verification
        {% endif %}

        [Install]
        WantedBy=multi-user.target
