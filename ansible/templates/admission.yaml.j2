apiVersion: apiserver.config.k8s.io/v1
kind: AdmissionConfiguration
plugins:
  - name: PodSecurity
    configuration:
      apiVersion: pod-security.admission.config.k8s.io/v1
      kind: PodSecurityConfiguration
      # Only for namespaces without labels; a label always wins.
      defaults:
        enforce: baseline
        enforce-version: latest
        audit: restricted
        audit-version: latest
        warn: restricted
        warn-version: latest
      # An exempt namespace skips audit and warn as well; see
      # docs/platform/security-policies.md#pod-security-admission
      exemptions:
        usernames: []
        runtimeClasses: []
        namespaces:
          - kube-system
          - kured
          - logging
          - backup
