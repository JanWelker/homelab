apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: "{{ hostvars[inventory_hostname]['ansible_host'] }}"
  bindPort: 6443
nodeRegistration:
  criSocket: "unix:///var/run/containerd/containerd.sock"
  imagePullPolicy: IfNotPresent
  name: "{{ inventory_hostname }}"
  taints: null
{% if role == 'control-plane' and inventory_hostname == groups['control_plane'][0] and (bootstrap_cluster | default(false) | bool) %}
# Only kubeadm init reads these; every other node joins with flags from
# /opt/bootstrap-k8s.env, see butane_node_config.yaml.j2.
bootstrapTokens:
  - groups:
      - system:bootstrappers:kubeadm:default-node-token
    token: "{{ kubeadm_token }}"
    ttl: 24h0m0s
    usages:
      - signing
      - authentication
certificateKey: "{{ certificate_key }}"
{% endif %}
patches:
  directory: /etc/kubernetes/patches
timeouts:
  controlPlaneComponentHealthCheck: 4m0s
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
controlPlaneEndpoint: "{{ control_plane_endpoint }}"
# Cilium replaces kube-proxy; the flags below are explained in
# docs/architecture/security.md#node-hardening
proxy:
  disabled: true
apiServer:
{% if control_plane_endpoint_host != control_plane_vip %}
  # kubeadm adds controlPlaneEndpoint itself; the VIP is what Cilium and the
  # operator's kubeconfig use.
  certSANs:
    - "{{ control_plane_vip }}"
{% endif %}
  extraArgs:
    # Needs serverTLSBootstrap below and kubelet-csr-approver.
    - name: kubelet-certificate-authority
      value: /etc/kubernetes/pki/ca.crt
    # NodeRestriction is kubeadm's default; the flag replaces the list.
    - name: enable-admission-plugins
      value: NodeRestriction,DenyServiceExternalIPs
    - name: tls-cipher-suites
      # yamllint disable-line rule:line-length
      value: "TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384,TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384,TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256,TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256,TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305,TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305"
    - name: tls-min-version
      value: VersionTLS12
    - name: encryption-provider-config
      value: /etc/kubernetes/enc/encryption-config.yaml
    - name: encryption-provider-config-automatic-reload
      value: "true"
    - name: audit-policy-file
      value: /etc/kubernetes/audit/policy.yaml
    - name: audit-log-path
      value: /var/log/kubernetes/audit/audit.log
    - name: audit-log-maxage
      value: "30"
    - name: audit-log-maxbackup
      value: "10"
    - name: audit-log-maxsize
      value: "100"
    - name: admission-control-config-file
      value: /etc/kubernetes/admission/admission.yaml
    - name: profiling
      value: "false"
  extraVolumes:
    - name: admission-config
      hostPath: /etc/kubernetes/admission
      mountPath: /etc/kubernetes/admission
      readOnly: true
      pathType: Directory
    - name: encryption-config
      hostPath: /etc/kubernetes/enc
      mountPath: /etc/kubernetes/enc
      readOnly: true
      pathType: Directory
    - name: audit-policy
      hostPath: /etc/kubernetes/audit
      mountPath: /etc/kubernetes/audit
      readOnly: true
      pathType: Directory
    - name: audit-log
      hostPath: /var/log/kubernetes/audit
      mountPath: /var/log/kubernetes/audit
      readOnly: false
      pathType: DirectoryOrCreate
certificatesDir: /etc/kubernetes/pki
clusterName: kubernetes
# The metrics listeners bind the node's own address through per-node patches
# in /etc/kubernetes/patches: this section is stored once for the whole
# cluster, so it cannot name an address.
controllerManager:
  extraArgs:
    - name: profiling
      value: "false"
dns: {}
etcd:
  local:
    dataDir: /var/lib/etcd
imageRepository: registry.k8s.io
kubernetesVersion: {{ kubernetes_version }}
networking:
  dnsDomain: cluster.local
  serviceSubnet: {{ service_subnet }}
  podSubnet: {{ pod_subnet }}
scheduler:
  extraArgs:
    - name: profiling
      value: "false"
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
serverTLSBootstrap: true
# Needs the sysctls in butane_node_config.yaml.j2, or the kubelet refuses to
# start; see docs/architecture/security.md#node-hardening
protectKernelDefaults: true
podPidsLimit: 4096
# The API server's suites and floor, for the kubelet's own listener on 10250.
tlsCipherSuites:
  - TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384
  - TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384
  - TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256
  - TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
  - TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305
  - TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305
tlsMinVersion: VersionTLS12
# A reboot or power-off without a drain still gives pods a SIGTERM window; see
# docs/architecture/security.md#node-hardening
shutdownGracePeriod: 60s
shutdownGracePeriodCriticalPods: 20s
# Keeps memory outside kubepods.slice for systemd, sshd and the kubelet; see
# docs/architecture/security.md#node-hardening
systemReserved:
  memory: 512Mi
kubeReserved:
  memory: 256Mi
# A partial map zeroes the signals it leaves out, so the defaults are restated.
evictionHard:
  memory.available: 256Mi
  nodefs.available: "10%"
  nodefs.inodesFree: "5%"
  imagefs.available: "15%"
  imagefs.inodesFree: "5%"
