apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: "{{ hostvars[inventory_hostname]['ansible_host'] }}"
  bindPort: 6443
nodeRegistration:
  criSocket: "unix:///var/run/containerd/containerd.sock"
  imagePullPolicy: IfNotPresent
  name: "{{ inventory_hostname }}"
  taints: null
  skipPhases:
    - addon/kube-proxy
bootstrapTokens:
  - groups:
      - system:bootstrappers:kubeadm:default-node-token
    token: "{{ kubeadm_token }}"
    ttl: 24h0m0s
    usages:
      - signing
      - authentication
certificateKey: "{{ certificate_key }}"
timeouts:
  controlPlaneComponentHealthCheck: 4m0s
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
controlPlaneEndpoint: "{{ control_plane_endpoint }}"
apiServer:
  extraArgs:
    # Verify the kubelet's serving certificate instead of trusting whatever
    # answers on port 10250. Without this the API server accepts any certificate
    # for exec, logs, attach and port-forward, so anything able to intercept
    # that connection can impersonate a kubelet -- and those are exactly the
    # calls carrying command output and log contents.
    #
    # Most clusters cannot turn this on, because the kubelet self-signs by
    # default and no CA can verify it. This one can: serverTLSBootstrap below
    # makes the kubelet request a real certificate from the cluster CA, and
    # kubelet-csr-approver approves those CSRs against a node-name regex and the
    # 10.9.2.0/24 prefix. The result is signed by CN=kubernetes with the node's
    # InternalIP in its SANs, which is the address
    # --kubelet-preferred-address-types=InternalIP makes the API server dial.
    #
    # metrics-server already does the same verification against the same
    # certificates and has been healthy, which is the practical proof this
    # works rather than an argument that it should.
    - name: kubelet-certificate-authority
      value: /etc/kubernetes/pki/ca.crt
    # spec.externalIPs on a Service lets whoever can create it hijack traffic to
    # an arbitrary address on every node -- there is no ownership check on the
    # address at all. Nothing here uses the field: LoadBalancer addresses come
    # from Cilium's LB pools, and `kubectl get svc -A` finds zero Services with
    # externalIPs set. This makes that a rule rather than a fact.
    #
    # NodeRestriction is kubeadm's default and has to be repeated: naming the
    # flag replaces the default list rather than adding to it.
    - name: enable-admission-plugins
      value: NodeRestriction,DenyServiceExternalIPs
    # Go's defaults still include CBC and 3DES suites. Restricted to AEAD
    # constructions on ECDHE, which every client here speaks -- kubectl, the
    # controllers and the kubelets are all Go. TLS 1.3 negotiates its own suites
    # and ignores this list; the floor below is what stops a downgrade to 1.0
    # or 1.1.
    - name: tls-cipher-suites
      # yamllint disable-line rule:line-length
      value: "TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384,TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384,TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256,TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256,TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305,TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305"
    - name: tls-min-version
      value: VersionTLS12
    - name: encryption-provider-config
      value: /etc/kubernetes/enc/encryption-config.yaml
    - name: encryption-provider-config-automatic-reload
      value: "true"
    - name: audit-policy-file
      value: /etc/kubernetes/audit/policy.yaml
    - name: audit-log-path
      value: /var/log/kubernetes/audit/audit.log
    - name: audit-log-maxage
      value: "30"
    - name: audit-log-maxbackup
      value: "10"
    - name: audit-log-maxsize
      value: "100"
  extraVolumes:
    - name: encryption-config
      hostPath: /etc/kubernetes/enc
      mountPath: /etc/kubernetes/enc
      readOnly: true
      pathType: Directory
    - name: audit-policy
      hostPath: /etc/kubernetes/audit
      mountPath: /etc/kubernetes/audit
      readOnly: true
      pathType: Directory
    - name: audit-log
      hostPath: /var/log/kubernetes/audit
      mountPath: /var/log/kubernetes/audit
      readOnly: false
      pathType: DirectoryOrCreate
certificatesDir: /etc/kubernetes/pki
clusterName: kubernetes
controllerManager:
  extraArgs:
    - name: bind-address
      value: "0.0.0.0"
dns: {}
etcd:
  local:
    dataDir: /var/lib/etcd
    extraArgs:
      - name: listen-metrics-urls
        value: "http://0.0.0.0:2381"
imageRepository: registry.k8s.io
kubernetesVersion: {{ kubernetes_version }}
networking:
  dnsDomain: cluster.local
  serviceSubnet: {{ service_subnet }}
  podSubnet: {{ pod_subnet }}
scheduler:
  extraArgs:
    - name: bind-address
      value: "0.0.0.0"
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
serverTLSBootstrap: true
# Stop the kubelet rewriting the host's kernel parameters behind your back. With
# this false -- the default -- it silently sets vm.overcommit_memory,
# kernel.panic, kernel.panic_on_oops and vm.panic_on_oom at startup. With it
# true it sets nothing and refuses to start if they are not already right.
#
# That inversion is the whole point and also the hazard: it moves responsibility
# for those four values onto the node image. They are set in
# /etc/sysctl.d/k8s.conf by butane_node_config.yaml.j2, and the two changes have
# to travel together. Without the sysctl drop-in a fresh node comes up at the
# kernel's own defaults -- overcommit_memory 0, panic 0 -- the kubelet finds
# them wrong and exits, and the node never joins. That failure would not show up
# on merge either, only at the next `make reinstall`.
protectKernelDefaults: true
# Nothing capped PIDs per pod, so one pod could exhaust the node's PID space and
# take the kubelet and every other pod on that node with it. The dramatic
# version is a fork bomb; the realistic one is a process that stops reaping its
# children. 4096 is well above anything running here and well below the node's
# kernel.pid_max.
podPidsLimit: 4096
