apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: "{{ hostvars[inventory_hostname]['ansible_host'] }}"
  bindPort: 6443
nodeRegistration:
  criSocket: "unix:///var/run/containerd/containerd.sock"
  imagePullPolicy: IfNotPresent
  name: "{{ inventory_hostname }}"
  taints: null
  skipPhases:
    - addon/kube-proxy
bootstrapTokens:
  - groups:
      - system:bootstrappers:kubeadm:default-node-token
    token: "{{ kubeadm_token }}"
    ttl: 24h0m0s
    usages:
      - signing
      - authentication
certificateKey: "{{ certificate_key }}"
# v1beta4 moved this out of apiServer.timeoutForControlPlane, which no longer
# exists on ClusterConfiguration.
timeouts:
  controlPlaneComponentHealthCheck: 4m0s
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
controlPlaneEndpoint: "{{ control_plane_endpoint }}"
apiServer:
  # Encrypt Secrets at rest in etcd. Without this a Secret is stored as
  # plaintext, so anything with read access to an etcd data directory or a
  # backup of one reads every credential the cluster holds.
  #
  # `identity` is listed after `secretbox` deliberately: new writes are
  # encrypted, and Secrets written before this was enabled stay readable. They
  # are not rewritten automatically -- see docs/architecture/security.md.
  extraArgs:
    - name: encryption-provider-config
      value: /etc/kubernetes/enc/encryption-config.yaml
    - name: encryption-provider-config-automatic-reload
      value: "true"
  extraVolumes:
    - name: encryption-config
      hostPath: /etc/kubernetes/enc
      mountPath: /etc/kubernetes/enc
      readOnly: true
      pathType: Directory
certificatesDir: /etc/kubernetes/pki
clusterName: kubernetes
# kubeadm binds these two to 127.0.0.1 by default, which leaves the
# kube-prometheus-stack ServiceMonitors for them permanently down and the
# matching KubeSchedulerDown / KubeControllerManagerDown alerts permanently
# firing. The nodes sit on a trusted segment and both endpoints require
# authentication, so binding them to the node address is the intended fix.
controllerManager:
  extraArgs:
    - name: bind-address
      value: "0.0.0.0"
dns: {}
etcd:
  local:
    dataDir: /var/lib/etcd
    # Serves only /metrics and /health, on a separate port from the client and
    # peer APIs, which stay on their mTLS listeners.
    extraArgs:
      - name: listen-metrics-urls
        value: "http://0.0.0.0:2381"
imageRepository: registry.k8s.io
kubernetesVersion: {{ kubernetes_version }}
networking:
  dnsDomain: cluster.local
  serviceSubnet: {{ service_subnet }}
  podSubnet: {{ pod_subnet }}
scheduler:
  extraArgs:
    - name: bind-address
      value: "0.0.0.0"
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
# Request a real serving certificate from the cluster CA instead of the
# self-signed one the kubelet generates. metrics-server then verifies the
# kubelet it scrapes rather than being run with --kubelet-insecure-tls.
# The resulting CSRs are approved by kubelet-csr-approver; until that is
# running they stay Pending and the kubelet keeps its self-signed cert.
serverTLSBootstrap: true
