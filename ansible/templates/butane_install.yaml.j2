variant: flatcar
version: 1.0.0
# Installer config. This is *not* the config the node runs on -- it is a
# throwaway environment whose only job is to write Flatcar to disk and reboot
# into it. The real config is ignition-{{ inventory_hostname }}.json, which is
# embedded into the OEM partition by flatcar-install and read on first boot from
# disk.
#
# Served only to the `install` entry in the PXE menu, which has to be chosen
# deliberately. The menu's default boots the local disk, so a node that reboots
# while the boot server happens to be running does not reinstall itself.
passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - "{{ lookup('file', '~/.ssh/id_ed25519.pub') }}"
storage:
  # The first half of "leave nothing of the previous install", and Ignition does
  # it rather than a script: wiping the table happens in the initramfs, before
  # anything else in this config runs. The second half is the rook-osd wipe in
  # butane_config.yaml.j2, which clears the Ceph signature the new partition
  # inherits -- `ceph-volume` reads that signature rather than the partition
  # table, so an OSD outlives a repartition unless something erases it.
  disks:
    - device: {{ install_disk }}
      wipe_table: true

  files:
    # The disk image is not staged here. flatcar-install streams it from the
    # boot server itself, which keeps ~700MB out of the PXE environment's tmpfs
    # and is what lets it check the signature -- see the units below.
    - path: /opt/ignition-final.json
      contents:
        source: http://{{ boot_server_ip }}:8000/ignition-{{ inventory_hostname }}.json

systemd:
  units:
    # Two units rather than one, because the only difference between them is
    # `-u` and the only way to decide is to look at the firmware. A
    # ConditionPathExists on /sys/firmware/efi expresses that; an `if` in a
    # shell script is the same decision with somewhere to hide.
    #
    # -b and -V rather than -f. Handed a local file, flatcar-install skips
    # signature verification entirely; pointed at a mirror it downloads the
    # image, downloads the detached signature beside it, and checks both
    # against Flatcar's signing key before writing a byte. `make download`
    # serves the <version>/ layout that makes the node's URL resolve.
    #
    # Which matters more than it looks. The boot server is unauthenticated HTTP
    # on a segment this repository already describes as only conditionally
    # trusted, and this is the one artifact on it that becomes the operating
    # system. The SHA512 Ansible checks at download time protects the copy on
    # the deployment host; this protects the copy the node actually writes.
    #
    # blkdiscard returns the whole device to unwritten, which leaves nothing
    # anywhere for anything to recognise. SATA devices without TRIM decline it,
    # hence the `-` prefix -- the wipe_table above is what is load-bearing.
    - name: flatcar-install.service
      enabled: true
      contents: |
        [Unit]
        Description=Install Flatcar to {{ install_disk }} (BIOS)
        Requires=network-online.target
        After=network-online.target
        ConditionPathExists=!/sys/firmware/efi

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        StandardOutput=journal+console
        StandardError=journal+console
        ExecStartPre=-/usr/bin/blkdiscard --force {{ install_disk }}
        ExecStart=/usr/bin/flatcar-install -d {{ install_disk }} \
          -b http://{{ boot_server_ip }}:8000 \
          -V {{ flatcar_version }} \
          -i /opt/ignition-final.json
        # Deliberately only on success. A failed install leaves the node in the
        # PXE environment with a journal and a working SSH key, which is where
        # you want to be -- rebooting would hand you a machine that PXE-boots
        # and fails again with the evidence gone.
        ExecStartPost=/usr/bin/systemctl reboot

        [Install]
        WantedBy=multi-user.target

    # Identical but for `-u`, which writes an NVRAM boot entry for the disk.
    # That is what makes "boot from disk" the firmware's own choice rather than
    # a fallback it reaches after PXE fails.
    - name: flatcar-install-uefi.service
      enabled: true
      contents: |
        [Unit]
        Description=Install Flatcar to {{ install_disk }} (UEFI)
        Requires=network-online.target
        After=network-online.target
        ConditionPathExists=/sys/firmware/efi

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        StandardOutput=journal+console
        StandardError=journal+console
        ExecStartPre=-/usr/bin/blkdiscard --force {{ install_disk }}
        ExecStart=/usr/bin/flatcar-install -d {{ install_disk }} \
          -b http://{{ boot_server_ip }}:8000 \
          -V {{ flatcar_version }} \
          -i /opt/ignition-final.json \
          -u
        ExecStartPost=/usr/bin/systemctl reboot

        [Install]
        WantedBy=multi-user.target
