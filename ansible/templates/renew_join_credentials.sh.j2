#!/bin/sh
# Run on a control plane by make config. The token and the certificate key reach
# kubeadm on its standard input, never in an argument list; see
# docs/architecture/security.md#provisioning
set -eu
kubeadm token delete {{ kubeadm_token.split('.')[0] }} >/dev/null 2>&1 || true
kubeadm token create --config /dev/stdin >/dev/null <<'EOF'
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
bootstrapTokens:
  - token: "{{ kubeadm_token }}"
    ttl: 24h0m0s
    description: renewed by make config
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
kubernetesVersion: {{ kubernetes_version }}
EOF
kubeadm init phase upload-certs --upload-certs --config /dev/stdin >/dev/null <<'EOF'
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
certificateKey: "{{ certificate_key }}"
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
kubernetesVersion: {{ kubernetes_version }}
EOF
