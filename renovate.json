{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "platformAutomerge": true,
  "extends": [
    "config:best-practices",
    ":dependencyDashboard",
    ":prHourlyLimitNone",
    ":prConcurrentLimitNone",
    ":timezone(Europe/Berlin)"
  ],
  "labels": [
    "dependencies"
  ],
  "schedule": "at any time",
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ]
  },
  "packageRules": [
    {
      "description": "One policy for everything: patch and minor automerge, majors wait for a human. Every component gets its own PR, except the three pairs grouped below that must move together.",
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true
    },
    {
      "description": "Major updates always require review.",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Three days between a release and its PR, for every datasource that pins something a node installs or the cluster runs. Long enough for an upstream to pull a broken or compromised tag, short enough that a fix still arrives the same week. Renovate lifts this for its own vulnerability-alert PRs.",
      "matchDatasources": [
        "docker",
        "helm",
        "github-releases",
        "github-tags",
        "npm",
        "pypi",
        "custom.flatcar-stable",
        "custom.syslinux-kernelorg"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "pyproject.toml declares >= ranges, which every new release already satisfies; without bump Renovate never opens a PR for the linters or the docs generator.",
      "matchManagers": [
        "pep621"
      ],
      "rangeStrategy": "bump"
    },
    {
      "description": "The CRDs must not lag the operator chart: one PR for both, so the pair cannot automerge separately.",
      "matchDatasources": [
        "helm"
      ],
      "matchDepNames": [
        "prometheus-operator-crds",
        "kube-prometheus-stack"
      ],
      "groupName": "prometheus operator"
    },
    {
      "description": "Rook requires the operator and cluster charts on the same version.",
      "matchDatasources": [
        "helm"
      ],
      "matchDepNames": [
        "rook-ceph",
        "rook-ceph-cluster"
      ],
      "groupName": "rook-ceph"
    },
    {
      "description": "The Lint Markdown workflow and the pre-commit hook must run the same markdownlint-cli2, or a commit passes locally and fails CI.",
      "matchDepNames": [
        "markdownlint-cli2",
        "DavidAnson/markdownlint-cli2"
      ],
      "groupName": "markdownlint-cli2"
    },
    {
      "description": "Strip kubernetes- prefix from sysext-bakery release tags",
      "matchDepNames": [
        "kubernetes"
      ],
      "extractVersion": "^kubernetes-(?<version>.+)$"
    },
    {
      "description": "Strip containerd- prefix from sysext-bakery release tags",
      "matchDepNames": [
        "containerd"
      ],
      "extractVersion": "^containerd-(?<version>.+)$"
    },
    {
      "description": "A Helm `tag:` override holds a bare tag, so docker:pinDigests has nowhere to write a digest and fails the whole shared pin branch. Add a bare-tag docker pin here or the Dependency Dashboard reports `Error updating branch: update failure`. Images written as a full reference keep their digests -- see docs/development/maintenance.md",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "docker.io/library/postgres",
        "ecr-public.aws.com/docker/library/haproxy",
        "ecr-public.aws.com/docker/library/redis",
        "registry.k8s.io/sig-storage/csi-provisioner",
        "registry.k8s.io/sig-storage/csi-resizer",
        "registry.k8s.io/sig-storage/csi-snapshotter"
      ],
      "pinDigests": false
    },
    {
      "description": "Authentik's bundled Postgres stays on major 17 until upstream moves it: a Postgres major is a dump and restore, not an image bump. Written as a regex so Renovate matches the tag directly -- a range like `<18` is graded by npm semver, where a three-part tag such as 17.11.1-trixie parses as a prerelease and is dropped from any range that does not name one. The `-trixie` suffix is held separately by docker versioning, not by this rule. See docs/development/maintenance.md",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "docker.io/library/postgres"
      ],
      "allowedVersions": "/^17\\./"
    }
  ],
  "pre-commit": {
    "enabled": true
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^payload/.+\\.yaml$/"
    ]
  },
  "argocd": {
    "managerFilePatterns": [
      "/^payload/.+\\.yaml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/^payload/.+values\\.yaml$/"
    ]
  },
  "customDatasources": {
    "flatcar-stable": {
      "defaultRegistryUrlTemplate": "https://stable.release.flatcar-linux.net/amd64-usr/current/version.txt",
      "format": "plain",
      "transformTemplates": [
        "{ \"releases\": [releases[$contains(version, \"FLATCAR_VERSION=\")].{ \"version\": $substringAfter(version, \"=\") }] }"
      ]
    },
    "syslinux-kernelorg": {
      "defaultRegistryUrlTemplate": "https://mirrors.edge.kernel.org/pub/linux/utils/boot/syslinux/sha256sums.asc",
      "format": "plain",
      "transformTemplates": [
        "{ \"releases\": [releases[$contains(version, \"syslinux-\") and $contains(version, \".tar.xz\")].{ \"version\": $match(version, /syslinux-([0-9.]+)\\.tar\\.xz/)[0].groups[0] }] }"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^ansible/inventory\\.yaml$/"
      ],
      "matchStrings": [
        "flatcar_version:\\s*['\"]?(?<currentValue>[0-9.]+)['\"]?"
      ],
      "depNameTemplate": "flatcar",
      "datasourceTemplate": "custom.flatcar-stable"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^ansible/inventory\\.yaml$/"
      ],
      "matchStrings": [
        "kubernetes_version:\\s*['\"]?(?<currentValue>v?[0-9.]+)['\"]?"
      ],
      "depNameTemplate": "kubernetes",
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "flatcar/sysext-bakery"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^ansible/inventory\\.yaml$/"
      ],
      "matchStrings": [
        "containerd_version:\\s*['\"]?(?<currentValue>[0-9.]+)['\"]?"
      ],
      "depNameTemplate": "containerd",
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "flatcar/sysext-bakery"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^ansible/inventory\\.yaml$/"
      ],
      "matchStrings": [
        "kube_vip_version:\\s*['\"]?(?<currentValue>v[0-9.]+)['\"]?"
      ],
      "depNameTemplate": "kube-vip",
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "kube-vip/kube-vip"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^ansible/inventory\\.yaml$/"
      ],
      "matchStrings": [
        "syslinux_version:\\s*['\"]?(?<currentValue>[0-9.]+)['\"]?"
      ],
      "depNameTemplate": "syslinux",
      "datasourceTemplate": "custom.syslinux-kernelorg",
      "description": "syslinux versions are two-part (6.03), which the default semver-coerced rejects -- without this versioning the dependency is extracted and then silently dropped before lookup.",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)$"
    },
    {
      "description": "Diff preview image. The Docker Hub namespace is `dagandersen`, without the hyphen the GitHub org `dag-andersen` has -- matching on the org spelling makes this manager find nothing at all.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.*\\.yaml$/"
      ],
      "matchStrings": [
        "(?<depName>dagandersen/argocd-diff-preview):(?<currentValue>[a-zA-Z0-9_.-]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "autoReplaceStringTemplate": "{{{depName}}}{{#if newValue}}:{{{newValue}}}{{/if}}{{#if newDigest}}@{{{newDigest}}}{{/if}}"
    },
    {
      "description": "markdownlint-cli2 installed by the Lint Markdown workflow. Grouped with the pre-commit hook, which the pre-commit manager tracks separately.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/lint-markdown\\.yaml$/"
      ],
      "matchStrings": [
        "npm install -g markdownlint-cli2@(?<currentValue>[0-9.]+)"
      ],
      "depNameTemplate": "markdownlint-cli2",
      "datasourceTemplate": "npm"
    },
    {
      "description": "renovate-config-validator is only as good as the Renovate it ships with; the validate workflow pins that version.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/renovate-validate\\.yaml$/"
      ],
      "matchStrings": [
        "renovate@(?<currentValue>[0-9.]+)"
      ],
      "depNameTemplate": "renovate",
      "datasourceTemplate": "npm"
    },
    {
      "description": "Trivy version installed by setup-trivy. The github-actions manager tracks the action's SHA, not its `version:` input.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/image-scan\\.yaml$/"
      ],
      "matchStrings": [
        "uses: aquasecurity/setup-trivy@[^\\n]*\\n\\s+with:\\n\\s+version:\\s*['\"]?(?<currentValue>v[0-9.]+)['\"]?"
      ],
      "depNameTemplate": "trivy",
      "packageNameTemplate": "aquasecurity/trivy",
      "datasourceTemplate": "github-releases"
    },
    {
      "description": "Webfont releases vendored into docs/assets/fonts by scripts/update-fonts.sh",
      "customType": "regex",
      "managerFilePatterns": [
        "/^scripts/update-fonts\\.sh$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s+packageName=(?<packageName>\\S+)\\s+versioning=(?<versioning>\\S+)[^\\n]*\\n\\s*\\w+=\"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "description": "Track versions annotated with a `# renovate:` comment. Needed for image tags written inline in a Helm `valuesObject:`, which the helm-values manager only reads from real values files.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^payload/.+\\.yaml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?(?:\\s+extractVersion=(?<extractVersion>\\S+))?[^\\n]*\\n\\s*[\\w.-]+:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    }
  ]
}
